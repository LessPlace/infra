{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApplicationBucketRead",
      "Effect": "Allow",
      "Principal": {"CanonicalUser": "REPLACE_SERVICE_ACCOUNT_ID"},
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET"
    },
    {
      "Sid": "ApplicationObjects",
      "Effect": "Allow",
      "Principal": {"CanonicalUser": "REPLACE_SERVICE_ACCOUNT_ID"},
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/*"
    },
    {
      "Sid": "KeepOwnerAccess",
      "Effect": "Allow",
      "Principal": {"CanonicalUser": "REPLACE_OWNER_USER_ID"},
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::REPLACE_BUCKET", "arn:aws:s3:::REPLACE_BUCKET/*"]
    }
  ]
}
